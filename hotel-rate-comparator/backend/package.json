{
    "name": "hotel-rate-comparator-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Temporal-powered backend for the Hotel Rate Comparator",
    "scripts": {
        "dev:mock-suppliers": "ts-node-dev --respawn --transpile-only src/mockSuppliers/server.ts",
        "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
        "dev:api": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "test": "jest --runInBand",
        "test:watch": "jest --runInBand --watch",
        "lint": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@temporalio/activity": "^1.11.0",
        "@temporalio/client": "^1.11.0",
        "@temporalio/worker": "^1.11.0",
        "@temporalio/workflow": "^1.11.0",
        "axios": "^1.7.7",
        "cors": "^2.8.5",
        "express": "^4.19.2"
    },
    "devDependencies": {
        "@temporalio/testing": "^1.11.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.0",
        "jest": "^29.7.0",
        "nock": "^13.5.4",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.5.4"
    }
}